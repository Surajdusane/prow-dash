{
  "name": "prow-dash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run openapi:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "check-types": "next typegen && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,mjs,json,css,md,mdx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,mjs,json,css,md,mdx}\"",
    "openapi:generate": "tsx --conditions=react-server scripts/generate-openapi.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --conditions=react-server src/db/seed/index.ts",
    "db:reset": "tsx --conditions=react-server src/db/seed/index.ts --fresh",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx,mjs,json,css,md,mdx}": "prettier --write",
    "src/**/*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.2.0",
    "@scalar/nextjs-api-reference": "^0.12.11",
    "@shikijs/transformers": "^4.5.0",
    "@tanstack/react-query": "^5.104.2",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "@types/mdx": "^2.0.14",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^1.0.0-rc.4",
    "echarts": "^6.1.0",
    "fumadocs-core": "^16.17.1",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-ui": "^16.17.1",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/turbopack": "^4",
    "@trpc/openapi": "^11.19.0-alpha",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.1",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "intent": {
    "skills": [
      "*"
    ]
  }
}
